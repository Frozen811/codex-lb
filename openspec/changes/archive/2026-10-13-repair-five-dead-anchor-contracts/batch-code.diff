+        )
+        is should_retire
+    )
+    async with async_session_factory() as session:
+        marker = (await session.scalars(select(HttpBridgeSessionRecord))).one()
+        assert (marker.continuity_abandonment_scope, marker.continuity_abandoned_at) == original_marker
